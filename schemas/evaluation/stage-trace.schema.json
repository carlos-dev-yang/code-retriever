{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cidx/stage-trace/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "query_id", "required_group_ids", "observations", "terminal_state"],
  "properties": {
    "schema_version": {"const": 1}, "query_id": {"type": "string", "minLength": 1},
    "required_group_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observations": {"type": "array", "minItems": 11, "maxItems": 11, "prefixItems": [{"$ref":"#/$defs/s0"},{"$ref":"#/$defs/s1"},{"$ref":"#/$defs/s2"},{"$ref":"#/$defs/s3"},{"$ref":"#/$defs/s4"},{"$ref":"#/$defs/s5"},{"$ref":"#/$defs/s6"},{"$ref":"#/$defs/s7"},{"$ref":"#/$defs/s8"},{"$ref":"#/$defs/s9"},{"$ref":"#/$defs/s10"}], "items": false},
    "terminal_state": {"enum": ["complete", "failed"]}
  },
  "$defs": {
    "group_loss": {"anyOf": [{"enum": ["NO_LOSS", "SOURCE_DISCOVERY", "PARSE_OR_CHUNK", "FTS_CANDIDATE_MISS", "DENSE_SEGMENT_MISS", "PROVIDER_UNION_MISS", "SEGMENT_PARENT_COLLAPSE", "RRF_FUSION", "BODY_PACKAGING", "ASSISTANT_USE", "ASSISTANT_RESOLUTION"]}, {"pattern": "^OPERATION_FAILURE:(source_discovery|parser_chunker|fts_candidate|dense_segment|provider_union|segment_parent_collapse|rrf_fusion|body_packaging|assistant_use|assistant_resolution|operational)$"}]},
    "group": {"type": "object", "additionalProperties": false, "required": ["group_id", "present", "first_loss"], "properties": {"group_id": {"type": "string", "minLength": 1}, "present": {"type": "boolean"}, "first_loss": {"$ref": "#/$defs/group_loss"}}, "allOf": [{"if": {"properties": {"present": {"const": true}}}, "then": {"properties": {"first_loss": {"const": "NO_LOSS"}}}, "else": {"properties": {"first_loss": {"not": {"const": "NO_LOSS"}}}}}]},
    "stage": {"type": "object", "additionalProperties": false, "required": ["stage", "required", "status", "denominators", "group_observations", "candidate_count"], "properties": {"stage": {"enum": ["source_discovery", "parser_chunker", "fts_candidate", "dense_segment", "provider_union", "segment_parent_collapse", "rrf_fusion", "body_packaging", "assistant_use", "assistant_resolution", "operational"]}, "required": {"type": "boolean"}, "status": {"enum": ["OBSERVED", "NOT_OBSERVED"]}, "denominators": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "truth_unit", "count"], "properties": {"name": {"type": "string", "minLength": 1}, "truth_unit": {"type": "string", "minLength": 1}, "count": {"type": "integer", "minimum": 1}}}}, "group_observations": {"type": "array", "items": {"$ref": "#/$defs/group"}}, "failure_stage": {"enum": ["source_discovery", "parser_chunker", "fts_candidate", "dense_segment", "provider_union", "segment_parent_collapse", "rrf_fusion", "body_packaging", "assistant_use", "assistant_resolution", "operational"]}, "candidate_count": {"type": "integer", "minimum": 0}, "query_vector_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "allOf": [{"if": {"properties": {"required": {"const": true}}}, "then": {"properties": {"status": {"const": "OBSERVED"}, "denominators": {"minItems": 1}}}, "else": {"properties": {"status": {"const": "NOT_OBSERVED"}, "denominators": {"maxItems": 0}, "group_observations": {"maxItems": 0}, "candidate_count": {"const": 0}, "query_vector_sha256": false, "failure_stage": false}}}]},
    "s0": {"allOf": [{"$ref":"#/$defs/stage"},{"properties":{"stage":{"const":"source_discovery"}}}]}, "s1": {"allOf": [{"$ref":"#/$defs/stage"},{"properties":{"stage":{"const":"parser_chunker"}}}]}, "s2": {"allOf": [{"$ref":"#/$defs/stage"},{"properties":{"stage":{"const":"fts_candidate"}}}]}, "s3": {"allOf": [{"$ref":"#/$defs/stage"},{"properties":{"stage":{"const":"dense_segment"}}}]}, "s4": {"allOf": [{"$ref":"#/$defs/stage"},{"properties":{"stage":{"const":"provider_union"}}}]}, "s5": {"allOf": [{"$ref":"#/$defs/stage"},{"properties":{"stage":{"const":"segment_parent_collapse"}}}]}, "s6": {"allOf": [{"$ref":"#/$defs/stage"},{"properties":{"stage":{"const":"rrf_fusion"}}}]}, "s7": {"allOf": [{"$ref":"#/$defs/stage"},{"properties":{"stage":{"const":"body_packaging"}}}]}, "s8": {"allOf": [{"$ref":"#/$defs/stage"},{"properties":{"stage":{"const":"assistant_use"}}}]}, "s9": {"allOf": [{"$ref":"#/$defs/stage"},{"properties":{"stage":{"const":"assistant_resolution"}}}]}, "s10": {"allOf": [{"$ref":"#/$defs/stage"},{"properties":{"stage":{"const":"operational"}, "group_observations":{"maxItems":0}}}]}
  }
}
