{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"cidx/promotion-result/v1","type":"object","additionalProperties":false,"required":["schema_version","scope","status","prerequisite_sha256","passed_gates","failed_gates","applicable_gates"],"properties":{"schema_version":{"const":1},"scope":{"enum":["core_retrieval","release_candidate"]},"status":{"enum":["PROMOTION_EVIDENCE_READY","NOT_PROMOTION_READY"]},"prerequisite_sha256":{"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"passed_gates":{"type":"array","items":{"type":"string","minLength":1}},"failed_gates":{"type":"array","items":{"type":"string","minLength":1}},"incomplete_reason":{"type":"string","minLength":1},"applicable_gates":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"allOf":[{"if":{"properties":{"status":{"const":"PROMOTION_EVIDENCE_READY"}}},"then":{"properties":{"failed_gates":{"maxItems":0}},"not":{"required":["incomplete_reason"]}},"else":{"anyOf":[{"properties":{"failed_gates":{"minItems":1}}},{"required":["incomplete_reason"]}]}}]}
