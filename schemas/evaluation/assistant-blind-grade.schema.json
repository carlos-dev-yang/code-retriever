{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "status",
        "evidence_indices"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "covered",
            "missing",
            "invalid_evidence"
          ]
        },
        "evidence_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_text",
        "classification",
        "support_references"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_text": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "observed",
            "derived",
            "unresolved"
          ]
        },
        "support_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_index"
            ],
            "properties": {
              "evidence_index": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "enum": [
                  "observed",
                  "derived"
                ]
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "support_references": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "base_grade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blind_id",
        "outcome",
        "required_groups",
        "unsupported_claims",
        "contradicted_claims",
        "rationale"
      ],
      "properties": {
        "blind_id": {
          "type": "string",
          "pattern": "^blind-[0-9a-f]{12}$"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "incorrect",
            "ungradable"
          ]
        },
        "required_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "unsupported_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contradicted_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "v1_grade": {
      "$ref": "#/$defs/base_grade"
    },
    "v2_grade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blind_id",
        "outcome",
        "required_groups",
        "unsupported_claims",
        "contradicted_claims",
        "rationale",
        "material_claims"
      ],
      "properties": {
        "blind_id": {
          "type": "string",
          "pattern": "^blind-[0-9a-f]{12}$"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "incorrect",
            "ungradable"
          ]
        },
        "required_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "unsupported_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "claim_id of an unsupported material claim"
          }
        },
        "contradicted_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "claim_id of a contradicted material claim"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "material_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "corpus_id",
        "grades"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "grades": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/v1_grade"
          }
        }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "corpus_id",
        "grades"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "grades": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/v2_grade"
          }
        }
      }
    }
  }
}
