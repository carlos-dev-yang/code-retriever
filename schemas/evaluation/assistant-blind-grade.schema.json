{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "grades"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "grades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blind_id",
          "outcome",
          "required_groups",
          "unsupported_claims",
          "contradicted_claims",
          "rationale"
        ],
        "properties": {
          "blind_id": {"type": "string", "pattern": "^blind-[0-9a-f]{12}$"},
          "outcome": {
            "type": "string",
            "enum": ["complete", "partial", "incorrect", "ungradable"]
          },
          "required_groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["group_id", "status", "evidence_indices"],
              "properties": {
                "group_id": {"type": "string", "minLength": 1},
                "status": {
                  "type": "string",
                  "enum": ["covered", "missing", "invalid_evidence"]
                },
                "evidence_indices": {
                  "type": "array",
                  "items": {"type": "integer", "minimum": 0}
                }
              }
            }
          },
          "unsupported_claims": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "contradicted_claims": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
